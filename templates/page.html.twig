{#
/**
 * @file
 * Eric's Theme implementation to display a single page.
 *
 * Regions:
 * - page.header: Primary navigation, next to the site logo.
 * - page.highlighted: Primary admin actions and highlighted messages (e.g. status messages).
 * - page.content: The main content of the current page.
 * - page.footer: Footer content.
 */
#}
<div class="layout-container">

  <header class="site-header">
    {{ page.header }}
  </header>

  <main role="main" class="site-main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    {% if page.highlighted %}
      <div class="highlighted">
        {{ page.highlighted }}
      </div>
    {% endif %}

    <div class="site-content">
      {{ page.content }}
    </div>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner">
      <div class="site-footer__copyright">All rights reserved &copy; {{ "now"|date("Y") }}</div>
      <div class="site-footer__links">
        <a href="mailto:eric@ericbremner.ca">eric@ericbremner.ca</a>
        <a href="https://ca.linkedin.com/in/eric-bremner" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.33V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        </a>
      </div>
    </div>
    {% if page.footer %}{{ page.footer }}{% endif %}
  </footer>

</div>
